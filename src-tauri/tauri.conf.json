{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PsicoRegistro",
  "version": "0.1.1",
  "identifier": "br.com.psicoregistro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PsicoRegistro",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["PortugueseBR"], "installMode": "currentUser" },
      "wix": { "language": "pt-BR" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/waubinet/PsicoRegistro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQzZEOTc4OUU0NTMwMjAKUldRZ01FV2VlTm5HVVhmaUFEblRybThuUGI4S0VTNkdyN2VRa1ROMzYzM3B6N0tTUG8zdEdFZDIK"
    }
  }
}
